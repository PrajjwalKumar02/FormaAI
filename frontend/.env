# =============================================
#  API CONFIGURATION (REQUIRED)
# =============================================

# Backend API URL - Connect to your backend server
VITE_API_URL=http://localhost:5000/api

# WebSocket URL - For real-time features
VITE_WS_URL=ws://localhost:5000

# File Upload URL - For file uploads
VITE_UPLOAD_URL=http://localhost:5000/uploads


# =============================================
#  APP CONFIGURATION (Optional)
# =============================================

# Application name
VITE_APP_NAME=Forma AI

# Application version
VITE_APP_VERSION=1.0.0

# Environment mode
VITE_NODE_ENV=development


# =============================================
#  FEATURE FLAGS (Optional)
# =============================================

# Enable/disable AI features
VITE_ENABLE_AI=true

# Enable/disable analytics
VITE_ENABLE_ANALYTICS=true

# Enable/disable real-time chat
VITE_ENABLE_CHAT=false

# Enable/disable file uploads
VITE_ENABLE_UPLOAD=true


# =============================================
#  AUTHENTICATION (Optional)
# =============================================

# Token storage key
VITE_TOKEN_KEY=token

# User storage key
VITE_USER_KEY=user


# =============================================
#  PAGINATION DEFAULTS (Optional)
# =============================================

# Default items per page
VITE_DEFAULT_PAGE_SIZE=10

# Max items per page
VITE_MAX_PAGE_SIZE=100


# =============================================
#  UPLOAD LIMITS (Optional)
# =============================================

# Max file size in MB
VITE_MAX_FILE_SIZE=5

# Allowed file types
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
